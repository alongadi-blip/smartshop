rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if request.auth != null;
    }
    match /settings/prices {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // קבלות: רק אדמין. קבלה שהופקה לא נערכת ולא נמחקת; המונה רץ קדימה בלבד.
    match /receipts/{number} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
    match /settings/receiptCounter {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && (resource == null || request.resource.data.next > resource.data.next);
    }
    match /settings/business {
      allow read, write: if request.auth != null;
    }
    match /settings/orderCounter {
      allow read, write: if true;
    }
    // המלאי נקרא בחנות כדי לחסום מידה שאזלה, ומתעדכן בכל הזמנה חדשה.
    // מבקר לא מזוהה רשאי להזיז רק את ordered — הכמות שנקלטה נעולה לאדמין.
    match /settings/inventory {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    || (request.resource.data.shirt.total == resource.data.shirt.total
                        && request.resource.data.pants.total == resource.data.pants.total);
    }
  }
}
