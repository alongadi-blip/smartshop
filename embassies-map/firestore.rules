rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // POIs: anyone can read, only the admin (Google Sign-In) can write
    match /pois/{poiId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'alon.gadi@gmail.com'
                   && request.auth.token.email_verified == true;
    }
  }
}
