# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → service_role. Server only: this key bypasses RLS,
# so it must never appear in a NEXT_PUBLIC_ variable or reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Recipe extraction ───────────────────────────────────────────────────────
# Optional. Extraction first tries the free structured-data path (JSON-LD,
# OpenGraph, oEmbed); this key is only used when that path comes up empty,
# which is the normal case for Instagram, Facebook and pasted free text.
# Without it those sources fall back to manual entry.
ANTHROPIC_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
# Used to build invitation links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
