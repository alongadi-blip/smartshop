{
  "rules": {
    "smartshop": {
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "global": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email === 'alon.gadi@gmail.com' && auth.token.email_verified === true"
      },
      "$listId": {
        ".read": "auth != null && (!data.exists() || data.child('members').child(auth.uid).exists() || data.child('meta').child('owner').val() === auth.uid)",
        ".write": "auth != null && (!data.exists() || data.child('members').child(auth.uid).exists() || data.child('meta').child('owner').val() === auth.uid)",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.child('token').isString() && newData.child('token').val() === newData.parent().parent().child('meta').child('token').val()"
          }
        }
      }
    }
  }
}
