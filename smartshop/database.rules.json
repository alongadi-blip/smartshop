{
  "rules": {
    "smartshop": {
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "global": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email === 'alon.gadi@gmail.com' && auth.token.email_verified === true"
      },
      "$listId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
