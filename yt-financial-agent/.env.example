# Copy this file to ".env" and fill in your real keys.
# The .env file is git-ignored and never leaves your machine.

ANTHROPIC_API_KEY=sk-ant-paste-your-key-here

# Filled in at step 4 (Telegram):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only needed when running in the cloud (GitHub Actions).
# YouTube blocks datacenter IPs; Supadata gives 100 free transcripts/month.
SUPADATA_API_KEY=
